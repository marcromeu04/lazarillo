# Copia este fichero como .env y pon tu clave. .env no se sube al repo.
# Clave de Cartesia (voz + LLM del agente): https://play.cartesia.ai/keys
CARTESIA_API_KEY=
# Lo rellena solo `npm run setup` (el agente de voz que crea en tu cuenta).
CARTESIA_AGENT_ID_MEJORAS=
# Web con la que arranca la página (luego puedes explorar cualquier otra desde la propia app).
TARGET_URL=https://karumi.ai/es
PORT=3000
