# Copia este fichero como .env y pon tus claves. .env no se sube al repo.

# --- Voz (Cartesia) ---------------------------------------------------------------
# https://play.cartesia.ai/keys  ·  después: npm run setup (crea tu agente y rellena su id)
CARTESIA_API_KEY=
CARTESIA_AGENT_ID_MEJORAS=

# --- Modelo del agente de mapeo (opcional) -----------------------------------------
# Interpreta qué es la web y sus funcionalidades, y predice en tiempo real a qué páginas
# querrá ir el visitante. Sin modelo funciona igual, con una ficha y una predicción básicas.
# Vale cualquier proveedor con API en formato OpenAI, Anthropic o Google (se detecta por la URL).
#
# El de la demo, con OpenCode Go (rápido y barato: 0,15 $ / 0,50 $ por millón de tokens):
#   GLM-5.3-Flash:               URL https://opencode.ai/inference/go/openai/v1         MODEL glm-5.3-flash
# Más inteligentes (Artificial Analysis Intelligence Index ≥ 35), también con OpenCode Go:
#   Gemini 4 Argon (índice 50):  URL https://opencode.ai/inference/go/google/v1beta     MODEL gemini-4-argon
#   Claude Haiku 5.5 (35-36):    URL https://opencode.ai/inference/go/anthropic/v1      MODEL claude-haiku-5-5
#   Grok 4.7 (35):               URL https://opencode.ai/inference/go/openai/v1         MODEL grok-4.7
# Otros proveedores:
#   OpenRouter:  URL https://openrouter.ai/api/v1          MODEL <proveedor/modelo>
#   Ollama:      URL http://localhost:11434/v1             MODEL <modelo local>  (sin clave)
#   OpenAI:      URL https://api.openai.com/v1             MODEL <modelo>
#   Anthropic:   URL https://api.anthropic.com/v1          MODEL claude-haiku-5-5
MAPEO_LLM_URL=https://opencode.ai/inference/go/openai/v1
MAPEO_LLM_MODEL=glm-5.3-flash
MAPEO_LLM_KEY=
# Razonamiento para la ficha (low | medium | high) y para la predicción en tiempo real.
MAPEO_LLM_ESFUERZO=low
MAPEO_LLM_ESFUERZO_PREDICCION=low

# Web con la que arranca la página (luego puedes explorar cualquier otra desde la propia app).
TARGET_URL=https://karumi.ai/es
PORT=3000
